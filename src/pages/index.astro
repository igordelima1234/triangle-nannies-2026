---
import BaseHead from '../components/BaseHead.astro';
import UtilityBar from '../components/UtilityBar.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Photo from '../components/Photo.astro';
import Reveal from '../components/Reveal.astro';
import TestimonialSlider from '../components/TestimonialSlider.astro';
import CommunityVideos from '../components/CommunityVideos.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const trustStrip = [
	{ text: '15+ years placing nannies in the Triangle' },
	{ text: 'Every candidate interviewed in person' },
	{ text: 'References verified by phone, not just email' },
	{ text: 'Background checks before any introduction is made' },
];

const soundFamiliar = [
	'Working through a schedule that no daycare can match',
	'Adjusting to a new baby and running out of hands',
	'Coping with a nanny who just gave notice',
	'Needing backup care for the days regular care falls through',
	'Managing two working parents and zero flexibility',
	'Wanting someone who feels like part of the family, not a stranger in the house',
];

const services = [
	{
		name: 'Full-Time Nanny',
		description:
			"A dedicated caregiver for your family's daily rhythm, from North Hills to Cary.",
		href: '/services/full-time-nanny',
		img: '/images/homepage/nanny-reading-circle.jpg',
		alt: 'A caregiver reading a picture book aloud to a small circle of children',
		hold: false,
	},
	{
		name: 'Part-Time Nanny',
		description:
			'Flexible coverage that bends around school pickup, work travel, and everything in between.',
		href: '/services/part-time-nanny',
		img: '/images/homepage/child-pointing-geese.jpg',
		alt: "A caregiver holding a young boy's hand as he points out geese by a pond",
		hold: false,
	},
	{
		name: 'Newborn Care Specialist',
		description:
			'Overnight and early-weeks support from someone who has done this hundreds of times.',
		href: '/services/newborn-care-specialist',
		img: '/images/homepage/parent-phone-baby.jpg',
		alt: 'A parent holding a baby close at home while checking their phone',
		hold: false,
	},
	{
		name: 'Backup & Temp Care',
		description: 'When your regular care falls through, we have someone ready.',
		href: '/services/backup-temp-care',
		img: '/images/homepage/caregivers-kids-books-group.jpg',
		alt: 'Caregivers reading picture books together with a small group of children',
		hold: false,
	},
	{
		name: 'Household Manager',
		// HOLD: do not publish until the Household Manager service page is live, per Austin
		description: '',
		href: '/services/household-manager',
		img: '',
		alt: '',
		hold: true,
	},
	{
		name: 'Doulas & Newborn Support',
		description: 'Support for the fourth trimester, on your schedule.',
		href: '/services/doulas-newborn-support',
		img: '/images/homepage/parents-swinging-toddler.jpg',
		alt: 'Two parents swinging a laughing toddler between them in a garden',
		hold: false,
	},
].filter((service) => !service.hold);

const steps = [
	{
		n: '01',
		title: 'Tell us about your household',
		body: 'Your schedule, your kids, your must-haves. The details that never fit on a form are the ones we listen hardest for.',
		img: '/images/homepage/family-pond-geese.jpg',
		alt: 'A family of three pausing together beside a pond lined with autumn trees',
	},
	{
		n: '02',
		title: 'We interview, verify, and check',
		body: 'Every candidate meets us in person. References get a phone call, not an email. Background checks come before any introduction.',
		img: '/images/homepage/kids-willow-tree.jpg',
		alt: 'Two children smiling together under a willow tree',
	},
	{
		n: '03',
		title: 'You meet your matches',
		body: 'We introduce the few who genuinely fit, then stay with you through the trial, the offer, and the first weeks.',
		img: '/images/homepage/nanny-reading-circle.jpg',
		alt: 'A caregiver reading a picture book aloud to a small circle of children',
	},
];

const statementStickers = [
	{
		src: '/images/homepage/stickers/austin-sticker.png',
		alt: '',
		style: 'top:-14%; left:3.5%; width:11rem; rotate:-16deg;',
	},
	{
		src: '/images/homepage/stickers/carrie-sticker.png',
		alt: '',
		style: 'top:-20%; left:36%; width:9rem; rotate:9deg;',
	},
	{
		src: '/images/homepage/stickers/igor-sticker.png',
		alt: '',
		style: 'top:-10%; right:5%; width:12.5rem; rotate:13deg;',
	},
	{
		src: '/images/homepage/stickers/kara-sticker.png',
		alt: '',
		style: 'top:70%; right:22%; width:12rem; rotate:-8deg;',
	},
	{
		src: '/images/homepage/stickers/mara-sticker.png',
		alt: '',
		style: 'top:66%; right:3.5%; width:10.5rem; rotate:-19deg;',
	},
	{
		src: '/images/homepage/stickers/noelle-sticker.png',
		alt: '',
		style: 'top:66%; left:14%; width:10.5rem; rotate:8deg;',
	},
];

---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<UtilityBar />

		<!-- Nav + hero share a grid stack so the pill nav floats over the photo -->
		<div class="hero-stack">
			<Nav overlay />
			<section class="hero" aria-label="Introduction">
				<img
					class="hero__media"
					src="/OPT-SSN-3-1_103.jpg"
					width="1920"
					height="1281"
					alt="A Triangle family sitting together in a garden, kids and parents laughing as bubbles float around them"
					fetchpriority="high"
					loading="eager"
				/>
				<div class="hero__scrim" aria-hidden="true"></div>
				<div class="container hero__content">
					<h1>Connecting vibrant families with extraordinary Triangle caregivers.</h1>
					<div class="hero__actions">
						<a class="btn btn-primary" href="/family-application">Start Your Search</a>
					</div>
					<a class="link-arrow hero__secondary" href="/candidates">Looking for nanny work? →</a>
				</div>
			</section>
		</div>

		<main id="main">
			<TestimonialSlider />

			<!-- Trust strip -->
			<section class="trust-strip" aria-label="Why families trust Triangle Nannies">
				<div class="container trust-strip__inner">
					{
						trustStrip.map((item, i) => (
							<div class="trust-strip__item reveal" style={`--reveal-delay:${i * 80}ms`}>
								<svg width="40" height="40" viewBox="0 0 73 73" fill="none" aria-hidden="true">
									<rect
										x="36.163"
										y="-4.14214"
										width="57"
										height="57"
										rx="10"
										transform="rotate(45 36.163 -4.14214)"
										fill="#FEB469"
									/>
									<path
										d="M35.2174 12.4268C35.3075 11.6682 36.4083 11.6682 36.4984 12.4268L37.2535 18.7908C38.2285 27.0083 44.7075 33.4872 52.925 34.4623L59.2889 35.2174C60.0476 35.3075 60.0476 36.4083 59.2889 36.4983L52.925 37.2535C44.7075 38.2285 38.2285 44.7074 37.2535 52.9249L36.4984 59.2889C36.4083 60.0475 35.3075 60.0475 35.2174 59.2889L34.4623 52.9249C33.4873 44.7074 27.0084 38.2285 18.7908 37.2535L12.4269 36.4983C11.6683 36.4083 11.6683 35.3075 12.4269 35.2174L18.7908 34.4623C27.0084 33.4872 33.4873 27.0083 34.4623 18.7908L35.2174 12.4268Z"
										fill="#FFECD1"
									/>
								</svg>
								<span>{item.text}</span>
							</div>
						))
					}
				</div>
			</section>

			<!-- Sound Familiar -->
			<section class="section section--cream">
				<div class="container grid grid-2">
					<div class="collage reveal">
						<div class="collage__main">
							<Photo
								ratio="3-4"
								src="/images/homepage/parent-phone-baby.jpg"
								alt="A parent holding a baby close at home while checking their phone"
								objectPosition="center 25%"
							/>
						</div>
						<div class="collage__inset">
							<Photo
								ratio="1-1"
								src="/images/homepage/nanny-kids-playing-balls.jpg"
								alt="A caregiver playing with two toddlers among scattered colorful balls"
								objectPosition="center 30%"
							/>
						</div>
					</div>
					<div class="reveal" style="--reveal-delay:120ms">
						<span class="eyebrow">For Families</span>
						<h2>This is a hire you want to get right the first time.</h2>
						<p class="lede">
							The daycare waitlist that never cleared. The schedule that became impossible the
							second school let out early. The care that fell through with two days' notice. We
							know how to help from that exact moment.
						</p>
						<ul class="checklist">
							{
								soundFamiliar.map((item) => (
									<li>
										<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
											<path
												d="M5 13l4 4L19 7"
												stroke="currentColor"
												stroke-width="2.2"
												stroke-linecap="round"
												stroke-linejoin="round"
											/>
										</svg>
										<span>{item}</span>
									</li>
								))
							}
						</ul>
						<a class="btn btn-primary" href="/families">See How We Match Families</a>
					</div>
				</div>
			</section>

			<!-- Services marquee -->
			<section class="services-marquee reveal" aria-label="Services we place">
				<div class="services-marquee__track">
					{
						Array.from({ length: 2 }).map((_, setIndex) =>
							services.map((service) => (
								<div class="services-marquee__item" aria-hidden={setIndex === 1 ? 'true' : undefined}>
									<span>{service.name}</span>
									<svg width="28" height="28" viewBox="0 0 73 73" fill="none" aria-hidden="true">
										<rect
											x="36.163"
											y="-4.14214"
											width="57"
											height="57"
											rx="10"
											transform="rotate(45 36.163 -4.14214)"
											fill="#FEB469"
										/>
										<path
											d="M35.2174 12.4268C35.3075 11.6682 36.4083 11.6682 36.4984 12.4268L37.2535 18.7908C38.2285 27.0083 44.7075 33.4872 52.925 34.4623L59.2889 35.2174C60.0476 35.3075 60.0476 36.4083 59.2889 36.4983L52.925 37.2535C44.7075 38.2285 38.2285 44.7074 37.2535 52.9249L36.4984 59.2889C36.4083 60.0475 35.3075 60.0475 35.2174 59.2889L34.4623 52.9249C33.4873 44.7074 27.0084 38.2285 18.7908 37.2535L12.4269 36.4983C11.6683 36.4083 11.6683 35.3075 12.4269 35.2174L18.7908 34.4623C27.0084 33.4872 33.4873 27.0083 34.4623 18.7908L35.2174 12.4268Z"
											fill="#FFECD1"
										/>
									</svg>
								</div>
							))
						)
					}
				</div>
			</section>

			<!-- Service cards -->
			<section class="section">
				<div class="container">
					<div class="section-head section-head--center reveal">
						<span class="eyebrow">What We Place</span>
						<h2>Your home is your haven.<br>We’ve got your crew.</h2>
					</div>
					<div class="service-grid">
						{
							services.map((service, i) => (
								<a
									class="service-card reveal"
									href={service.href}
									style={`--reveal-delay:${(i % 3) * 90}ms`}
								>
									<div class="service-card__media">
										<Photo ratio="4-3" src={service.img} alt={service.alt} />
									</div>
									<div class="service-card__body">
										<h3>{service.name}</h3>
										<p>{service.description}</p>
										<span class="link-arrow service-card__cta">
											Learn More <span aria-hidden="true">→</span>
										</span>
									</div>
								</a>
							))
						}
					</div>
				</div>
			</section>

			<!-- Statement band -->
			<section class="statement-band">
				<div class="statement-band__stickers" aria-hidden="true">
					{
						statementStickers.map((sticker) => (
							<img class="statement-band__sticker" src={sticker.src} alt="" style={sticker.style} />
						))
					}
				</div>
				<img
					class="statement-band__sticker statement-band__sticker--mobile"
					src="/images/homepage/stickers/austin-sticker.png"
					alt=""
					aria-hidden="true"
					style="top:-6%; right:5%; width:9.5rem; rotate:-14deg;"
				/>
				<div class="container statement-band__inner">
					<p class="statement-band__figure reveal">
						<span class="statement-band__number">15</span>
						<span class="statement-band__plus" aria-hidden="true">+</span>
					</p>
					<div class="statement-band__copy reveal" style="--reveal-delay:120ms">
						<h2>Years matching Triangle families with nannies they trust.</h2>
						<p class="lede">
							Raleigh, Durham, Chapel Hill, Cary, and everywhere in between. One conversation to
							start.
						</p>
						<a class="btn btn-primary" href="/family-application">Start Your Search</a>
					</div>
				</div>
			</section>

			<!-- How Placement Works -->
			<section class="section section--sage">
				<div class="container">
					<div class="section-head reveal">
						<span class="eyebrow">The Process</span>
						<h2>Finding the right nanny takes more than a resume review.</h2>
						<p class="lede">
							We interview every candidate in person, verify references by phone, and run a
							comprehensive background check before any introduction is made. Then we match on
							the details that actually matter: your schedule, your household, your kids'
							personalities, even the family with three kittens if that's a dealbreaker.
						</p>
					</div>
					<div class="step-grid">
						{
							steps.map((step, i) => (
								<div class="step reveal" style={`--reveal-delay:${i * 110}ms`}>
									<div class="step__media">
										<Photo ratio="4-3" src={step.img} alt={step.alt} />
										<span class="step__number">
											<svg
												class="step__number-shape"
												viewBox="0 0 226 266"
												fill="none"
												xmlns="http://www.w3.org/2000/svg"
												aria-hidden="true"
											>
												<path
													d="M42.8258 1.04307C42.991 -0.34769 45.0091 -0.34769 45.1742 1.04307L46.5586 12.7103C48.3462 27.7758 60.2242 39.6539 75.2896 41.4414L86.9568 42.8258C88.3477 42.991 88.3477 45.0091 86.9568 45.1742L75.2896 46.5586C60.2242 48.3462 48.3462 60.2242 46.5586 75.2896L45.1742 86.9568C45.0091 88.3477 42.991 88.3477 42.8258 86.9568L41.4414 75.2896C39.6539 60.2242 27.7758 48.3462 12.7103 46.5586L1.04307 45.1742C-0.34769 45.0091 -0.34769 42.991 1.04307 42.8258L12.7103 41.4414C27.7758 39.6539 39.6539 27.7758 41.4414 12.7103L42.8258 1.04307Z"
													fill="#69536A"
												></path>
												<rect
													x="120"
													y="44"
													width="164.049"
													height="164.049"
													rx="25.5551"
													transform="rotate(45 120 44)"
													fill="#69536A"
												></rect>
											</svg>
											<span class="step__number-value">{step.n}</span>
										</span>
									</div>
									<h3>{step.title}</h3>
									<p>{step.body}</p>
								</div>
							))
						}
					</div>
					<div class="step-grid__cta reveal">
						<a class="btn btn-primary" href="/how-it-works">See the Full Process</a>
					</div>
				</div>
			</section>

			<!-- Meet Austin -->
			<section class="section section--plum">
				<div class="container grid grid-2">
					<div class="reveal">
						<Photo
							ratio="1-1"
							src="/images/homepage/austin-macfarlane-founder.webp"
							alt="Austin Macfarlane, founder of Triangle Nannies"
						/>
					</div>
					<div class="reveal" style="--reveal-delay:120ms">
						<span class="eyebrow">Meet the Founder</span>
						<blockquote class="pull-quote">
							"I can always tell when a parent is white-knuckling through the call. They ask
							logistics questions right away because logistics feel safer than the thing they
							actually want to say: I don't know how to trust a stranger with my child."
						</blockquote>
						<p>
							Austin Macfarlane started Triangle Nannies after spending years trying to find
							reliable childcare for her own family. That experience is in the DNA of every
							placement we make.
						</p>
						<a class="btn btn-outline" href="/about">Read Austin's Story</a>
					</div>
				</div>
			</section>

			<!-- Trusted By / Community -->
			<section class="section section--plum section--tight-top">
				<div class="container">
					<div class="section-head section-head--center reveal">
						<span class="eyebrow">In the Community</span>
						<h2>Proud to be part of the Triangle.</h2>
					</div>
				</div>
				<div class="marquee reveal" style="--reveal-delay:120ms">
					<div class="marquee__track">
						{
							Array.from({ length: 2 }).map((_, setIndex) =>
								[
									{ src: "/images/homepage/partners/triangle-business-journal.webp", alt: "Triangle Business Journal" },
									{ src: "/images/homepage/partners/partner-2.webp", alt: "UNC Health Care" },
									{ src: "/images/homepage/partners/duke.webp", alt: "Duke University" },
									{ src: "/images/homepage/partners/partner-4.webp", alt: "Community partner" },
									{ src: "/images/homepage/partners/partner-5.webp", alt: "The Raleigh School" },
									{ src: "/images/homepage/partners/partner-6.webp", alt: "Hodge & Kittrell Sotheby's International Realty" },
									{ src: "/images/homepage/partners/partner-7.webp", alt: "Community partner" },
								].map((logo) => (
									<div class="marquee__item" aria-hidden={setIndex === 1 ? "true" : undefined}>
										<img src={logo.src} alt={setIndex === 1 ? "" : logo.alt} loading="lazy" />
									</div>
								))
							)
						}
					</div>
				</div>
			</section>

			<CommunityVideos />

			<!-- Final CTA band -->
			<section class="final-cta reveal">
				<div class="final-cta__copy">
					<span class="eyebrow">Ready when you are</span>
					<h2>Let's find the right person for your family.</h2>
					<p class="lede">Fifteen years in the Triangle. One conversation to start.</p>
					<a class="btn btn-primary" href="/get-started">Get Started</a>
				</div>
				<div class="final-cta__media" data-parallax>
					<img
						src="/images/homepage/parents-swinging-toddler.jpg"
						alt="A parent swinging a laughing toddler outdoors"
						data-parallax-img
						loading="lazy"
					/>
				</div>
			</section>
		</main>

		<Footer />
		<Reveal />

		<script>
			const parallaxEls = document.querySelectorAll<HTMLElement>('[data-parallax]');

			if (parallaxEls.length && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
				let ticking = false;

				const update = () => {
					ticking = false;
					for (const el of parallaxEls) {
						const img = el.querySelector<HTMLElement>('[data-parallax-img]');
						if (!img) continue;
						const rect = el.getBoundingClientRect();
						const viewportH = window.innerHeight;
						// -1 (el bottom at viewport top) .. 1 (el top at viewport bottom)
						const progress = (rect.top + rect.height / 2 - viewportH / 2) / (viewportH / 2 + rect.height / 2);
						const shift = progress * -14; // percent
						img.style.transform = `translate3d(0, ${shift}%, 0) scale(1.15)`;
					}
				};

				const onScroll = () => {
					if (!ticking) {
						ticking = true;
						requestAnimationFrame(update);
					}
				};

				update();
				window.addEventListener('scroll', onScroll, { passive: true });
				window.addEventListener('resize', onScroll);
			}
		</script>

		<style>
			/* Hero: nav and photo share one grid cell so the pill nav floats over the image */
			.hero-stack {
				display: grid;
				background: var(--cream);
				padding: 0.75rem;
			}

			@media (min-width: 700px) {
				.hero-stack {
					padding: 1.25rem;
				}
			}

			.hero-stack > :global(*) {
				grid-area: 1 / 1;
			}

			.hero-stack > :global(.site-header--overlay) {
				z-index: 10;
				padding-inline: 0.75rem;
				/* Grid items stretch to fill their cell by default, which made this
				   transparent header cover the full hero height and silently block
				   clicks on the headline/CTA beneath it. Keep it to its own content
				   height, pinned to the top, instead. */
				align-self: start;
			}

			.hero {
				position: relative;
				min-height: 34rem;
				display: flex;
				align-items: flex-end;
				justify-content: center;
				border-radius: var(--radius-lg);
				overflow: hidden;
				isolation: isolate;
			}

			@media (min-width: 700px) {
				.hero {
					min-height: 44rem;
				}
			}

			.hero__media {
				position: absolute;
				inset: 0;
				z-index: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center 20%;
				border-radius: 0;
				background: linear-gradient(135deg, var(--terracotta), var(--plum) 65%);
			}

			.hero__scrim {
				position: absolute;
				inset: 0;
				z-index: 1;
				background:
					linear-gradient(0deg, rgba(20, 12, 8, 0.8) 0%, rgba(20, 12, 8, 0.45) 42%, rgba(20, 12, 8, 0.22) 68%, rgba(20, 12, 8, 0.15) 100%),
					linear-gradient(180deg, rgba(20, 12, 8, 0.35) 0%, rgba(20, 12, 8, 0.1) 30%, rgba(20, 12, 8, 0) 55%);
			}

			.hero__content {
				position: relative;
				z-index: 2;
				padding-block: 6.5rem 2.5rem;
				max-width: 72rem;
				margin-inline: auto;
				color: var(--white);
				text-align: center;
			}

			.hero__content h1 {
				color: var(--white);
				font-size: clamp(2.75rem, 9vw, 4.5rem);
				line-height: 1.05;
				text-shadow: 0 2px 20px rgba(0, 0, 0, 0.35);
			}

			.hero__actions {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1.5rem;
				flex-wrap: wrap;
				margin-top: 2.25rem;
			}

			.hero__secondary {
				display: inline-flex;
				margin-top: 1rem;
				color: var(--white);
			}

			.hero__secondary:hover {
				color: var(--gold);
			}

			@media (min-width: 700px) {
				.hero__content {
					padding-block: 7.5rem 3.5rem;
				}
			}

			@media (min-width: 1100px) {
				.hero {
					align-items: center;
				}

				.hero__content {
					padding-block: 0;
				}
			}

			/* Trust strip */
			.trust-strip {
				background: var(--cream);
				padding-block: 3rem;
			}

			.trust-strip__inner {
				display: grid;
				gap: 2rem;
				grid-template-columns: 1fr;
			}

			@media (min-width: 700px) {
				.trust-strip__inner {
					grid-template-columns: repeat(2, 1fr);
				}
			}

			@media (min-width: 1100px) {
				.trust-strip__inner {
					grid-template-columns: repeat(4, 1fr);
				}
			}

			.trust-strip__item {
				display: flex;
				flex-direction: column;
				align-items: center;
				text-align: center;
				gap: 0.75rem;
				font-family: var(--font-head);
				font-size: 1.5rem;
				font-weight: 500;
				line-height: 1.25;
				color: var(--text-dark);
			}

			.trust-strip__item svg {
				flex-shrink: 0;
				width: 40px;
				height: 40px;
			}

			/* Sound familiar */
			.collage {
				position: relative;
				padding-bottom: 3.5rem;
				padding-right: 2.5rem;
			}

			.collage__main {
				width: 88%;
			}

			.collage__inset {
				position: absolute;
				right: 0;
				bottom: 0;
				width: 46%;
				border-radius: 10px;
				overflow: hidden;
				box-shadow: var(--shadow-soft);
			}

			@media (min-width: 900px) {
				.collage {
					padding-bottom: 4.5rem;
				}
			}

			.checklist {
				list-style: none;
				display: flex;
				flex-direction: column;
				gap: 0.85rem;
				margin: 1.75rem 0 2.25rem;
			}

			.checklist li {
				display: flex;
				align-items: flex-start;
				gap: 0.75rem;
			}

			.checklist svg {
				flex-shrink: 0;
				color: var(--terracotta-dark);
				margin-top: 0.2rem;
			}

			/* Service cards */
			.service-grid {
				display: grid;
				gap: 2rem;
				grid-template-columns: 1fr;
			}

			@media (min-width: 640px) {
				.service-grid {
					grid-template-columns: repeat(2, 1fr);
				}
			}

			@media (min-width: 1024px) {
				.service-grid {
					grid-template-columns: repeat(3, 1fr);
				}
			}

			.service-card {
				display: flex;
				flex-direction: column;
				height: 100%;
				background: var(--white);
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow-card);
				overflow: hidden;
				text-decoration: none;
				color: inherit;
				transition:
					transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
					box-shadow 0.3s ease;
			}

			.service-card:hover {
				transform: translateY(-6px);
				box-shadow: 0 20px 44px rgba(44, 31, 23, 0.16);
				color: inherit;
			}

			.service-card__media {
				overflow: hidden;
			}

			.service-card__media :global(.ph),
			.service-card__media :global(.media) {
				border-radius: 0;
				transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
			}

			.service-card:hover .service-card__media :global(.ph),
			.service-card:hover .service-card__media :global(.media) {
				transform: scale(1.05);
			}

			.service-card__body {
				display: flex;
				flex-direction: column;
				gap: 0.6rem;
				padding: 1.6rem 1.75rem 1.9rem;
				flex-grow: 1;
			}

			.service-card__body h3 {
				margin: 0;
			}

			.service-card__body p {
				color: var(--text-muted);
				margin: 0;
				flex-grow: 1;
			}

			.service-card__cta {
				margin-top: 0.4rem;
			}

			.service-card:hover .service-card__cta {
				color: var(--terracotta-dark);
			}

			/* Statement band */
			.statement-band {
				position: relative;
				background: var(--plum);
				color: var(--white);
				padding: 4.5rem 0;
			}

			.statement-band__stickers {
				position: absolute;
				inset: 0;
				display: none;
				pointer-events: none;
			}

			@media (min-width: 900px) {
				.statement-band__stickers {
					display: block;
				}
			}

			.statement-band__sticker {
				position: absolute;
				z-index: 3;
				height: auto;
			}

			.statement-band__sticker--mobile {
				pointer-events: none;
			}

			@media (min-width: 900px) {
				.statement-band__sticker--mobile {
					display: none;
				}
			}

			@media (min-width: 768px) {
				.statement-band {
					padding: 6.5rem 0;
				}
			}

			.statement-band__inner {
				display: grid;
				gap: 2rem;
				align-items: center;
			}

			@media (min-width: 900px) {
				.statement-band__inner {
					grid-template-columns: auto 1fr;
					gap: 4.5rem;
				}
			}

			.statement-band__figure {
				display: flex;
				align-items: flex-start;
				color: var(--gold);
				line-height: 0.85;
			}

			.statement-band__number {
				font-family: var(--font-head);
				font-weight: 700;
				font-size: clamp(6rem, 16vw, 13rem);
				letter-spacing: -0.02em;
			}

			.statement-band__plus {
				font-family: var(--font-head);
				font-weight: 700;
				font-size: clamp(2.5rem, 6vw, 5rem);
				margin-top: 0.35em;
			}

			.statement-band__copy h2 {
				color: var(--white);
				max-width: 26ch;
			}

			.statement-band__copy .lede {
				color: rgba(255, 255, 255, 0.85);
				max-width: 46ch;
				margin-bottom: 2rem;
			}

			/* Process steps */
			.step-grid {
				display: grid;
				gap: 2.5rem;
				grid-template-columns: 1fr;
			}

			@media (min-width: 800px) {
				.step-grid {
					grid-template-columns: repeat(3, 1fr);
				}
			}

			.step__media {
				position: relative;
				margin-bottom: 1.5rem;
			}

			.step__number {
				position: absolute;
				top: 1.2rem;
				right: 1.6rem;
				width: 3.83rem;
				height: 4.5rem;
			}

			.step__number-shape {
				display: block;
				width: 100%;
				height: 100%;
				filter: drop-shadow(var(--shadow-soft));
			}

			.step__number-value {
				position: absolute;
				left: 53.1%;
				top: 60.2%;
				transform: translate(-50%, -50%);
				color: var(--white);
				font-family: var(--font-head);
				font-weight: 700;
				font-size: 1.1rem;
			}

			.step h3 {
				margin-bottom: 0.5rem;
			}

			.step p {
				color: #5d5145;
				margin: 0;
			}

			.step-grid__cta {
				margin-top: 3rem;
			}

			/* Meet Austin */
			.pull-quote {
				font-family: var(--font-head);
				font-size: clamp(1.35rem, 2.2vw, 1.75rem);
				font-weight: 500;
				line-height: 1.4;
				margin: 0 0 1.75rem;
				padding: 0;
				border: none;
				color: var(--white);
			}

			.section--tight-top {
				padding-top: 0;
			}

			/* Services marquee */
			.services-marquee {
				width: 100%;
				overflow: hidden;
				background: var(--plum);
				padding: 1.75rem 0;
				-webkit-mask-image: linear-gradient(
					to right,
					transparent,
					black 6%,
					black 94%,
					transparent
				);
				mask-image: linear-gradient(to right, transparent, black 6%, black 94%, transparent);
			}

			.services-marquee__track {
				display: flex;
				align-items: center;
				gap: 2.5rem;
				width: max-content;
				animation: services-marquee-scroll 36s linear infinite;
			}

			.services-marquee:hover .services-marquee__track {
				animation-play-state: paused;
			}

			.services-marquee__item {
				flex: none;
				display: flex;
				align-items: center;
				gap: 2.5rem;
			}

			.services-marquee__item span {
				font-family: var(--font-head);
				font-weight: 700;
				font-size: 1.5rem;
				white-space: nowrap;
				color: var(--white);
			}

			.services-marquee__item svg {
				flex: none;
			}

			@keyframes services-marquee-scroll {
				from {
					transform: translateX(0);
				}
				to {
					transform: translateX(-50%);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.services-marquee__track {
					animation: none;
				}
			}

			@media (min-width: 768px) {
				.services-marquee__item span {
					font-size: 1.875rem;
				}
			}

			/* Community logos marquee */
			.marquee {
				width: 100%;
				overflow: hidden;
				margin-top: 3rem;
				-webkit-mask-image: linear-gradient(
					to right,
					transparent,
					black 8%,
					black 92%,
					transparent
				);
				mask-image: linear-gradient(to right, transparent, black 8%, black 92%, transparent);
			}

			.marquee__track {
				display: flex;
				align-items: center;
				gap: 3.5rem;
				width: max-content;
				animation: marquee-scroll 32s linear infinite;
			}

			.marquee:hover .marquee__track {
				animation-play-state: paused;
			}

			.marquee__item {
				flex: none;
				display: flex;
				align-items: center;
				justify-content: center;
				height: 2.25rem;
			}

			.marquee__item img {
				height: 100%;
				width: auto;
				max-width: 9rem;
				object-fit: contain;
			}

			@keyframes marquee-scroll {
				from {
					transform: translateX(0);
				}
				to {
					transform: translateX(-50%);
				}
			}

			@media (prefers-reduced-motion: reduce) {
				.marquee__track {
					animation: none;
				}
			}

			/* Final CTA */
			.final-cta {
				display: grid;
				grid-template-columns: 1fr;
				width: 100%;
			}

			@media (min-width: 800px) {
				.final-cta {
					grid-template-columns: 2fr 3fr;
					min-height: 20rem;
				}
			}

			.final-cta__copy {
				background: var(--cream);
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: flex-start;
				padding: 2.5rem 1.75rem;
			}

			@media (min-width: 768px) {
				.final-cta__copy {
					padding: 2.5rem 2.5rem;
				}
			}

			@media (min-width: 1200px) {
				.final-cta__copy {
					padding: 2.5rem 3vw;
				}
			}

			.final-cta__copy .lede {
				margin-bottom: 1.5rem;
			}

			.final-cta__media {
				position: relative;
				overflow: hidden;
				min-height: 14rem;
			}

			.final-cta__media img {
				position: absolute;
				inset: -10% 0;
				width: 100%;
				height: 120%;
				object-fit: cover;
				will-change: transform;
				transform: translate3d(0, 0, 0) scale(1.15);
			}
		</style>
	</body>
</html>
