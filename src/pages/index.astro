---
import BaseHead from '../components/BaseHead.astro';
import UtilityBar from '../components/UtilityBar.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import ImagePlaceholder from '../components/ImagePlaceholder.astro';
import Photo from '../components/Photo.astro';
import Reveal from '../components/Reveal.astro';
import TestimonialSlider from '../components/TestimonialSlider.astro';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const trustStrip = [
	{
		text: '15+ years placing nannies in the Triangle',
		icon: 'M12 2l2.4 6.6L21 10l-5.4 4.2L17 21l-5-3.6L7 21l1.4-6.8L3 10l6.6-1.4z',
	},
	{
		text: 'Every candidate interviewed in person',
		icon: 'M12 2a5 5 0 100 10 5 5 0 000-10zM4 21a8 8 0 0116 0',
	},
	{
		text: 'References verified by phone, not just email',
		icon: 'M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6 19.79 19.79 0 01-3.07-8.67A2 2 0 014.11 2h3a2 2 0 012 1.72c.13.96.36 1.9.68 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.91.32 1.85.55 2.81.68A2 2 0 0122 16.92z',
	},
	{
		text: 'Background checks before any introduction is made',
		icon: 'M12 2l8 4v6c0 5-3.4 8.4-8 10-4.6-1.6-8-5-8-10V6z',
	},
];

const soundFamiliar = [
	'Working through a schedule that no daycare can match',
	'Adjusting to a new baby and running out of hands',
	'Coping with a nanny who just gave notice',
	'Needing backup care for the days regular care falls through',
	'Managing two working parents and zero flexibility',
	'Wanting someone who feels like part of the family, not a stranger in the house',
];

const services = [
	{
		name: 'Full-Time Nanny',
		description:
			"A dedicated caregiver for your family's daily rhythm, from North Hills to Cary.",
		href: '/services/full-time-nanny',
		img: '/images/homepage/nanny-reading-circle.jpg',
		alt: 'A caregiver reading a picture book aloud to a small circle of children',
		hold: false,
	},
	{
		name: 'Part-Time Nanny',
		description:
			'Flexible coverage that bends around school pickup, work travel, and everything in between.',
		href: '/services/part-time-nanny',
		img: '/images/homepage/child-pointing-geese.jpg',
		alt: "A caregiver holding a young boy's hand as he points out geese by a pond",
		hold: false,
	},
	{
		name: 'Newborn Care Specialist',
		description:
			'Overnight and early-weeks support from someone who has done this hundreds of times.',
		href: '/services/newborn-care-specialist',
		img: '/images/homepage/parent-phone-baby.jpg',
		alt: 'A parent holding a baby close at home while checking their phone',
		hold: false,
	},
	{
		name: 'Backup & Temp Care',
		description: 'When your regular care falls through, we have someone ready.',
		href: '/services/backup-temp-care',
		img: '/images/homepage/caregivers-kids-books-group.jpg',
		alt: 'Caregivers reading picture books together with a small group of children',
		hold: false,
	},
	{
		name: 'Household Manager',
		// HOLD: do not publish until the Household Manager service page is live, per Austin
		description: '',
		href: '/services/household-manager',
		img: '',
		alt: '',
		hold: true,
	},
	{
		name: 'Doulas & Newborn Support',
		description: 'Support for the fourth trimester, on your schedule.',
		href: '/services/doulas-newborn-support',
		img: '/images/homepage/parents-swinging-toddler.jpg',
		alt: 'Two parents swinging a laughing toddler between them in a garden',
		hold: false,
	},
].filter((service) => !service.hold);

const steps = [
	{
		n: '01',
		title: 'Tell us about your household',
		body: 'Your schedule, your kids, your must-haves. The details that never fit on a form are the ones we listen hardest for.',
		img: '/images/homepage/family-pond-geese.jpg',
		alt: 'A family of three pausing together beside a pond lined with autumn trees',
	},
	{
		n: '02',
		title: 'We interview, verify, and check',
		body: 'Every candidate meets us in person. References get a phone call, not an email. Background checks come before any introduction.',
		img: '/images/homepage/kids-willow-tree.jpg',
		alt: 'Two children smiling together under a willow tree',
	},
	{
		n: '03',
		title: 'You meet your matches',
		body: 'We introduce the few who genuinely fit, then stay with you through the trial, the offer, and the first weeks.',
		img: '/images/homepage/nanny-reading-circle.jpg',
		alt: 'A caregiver reading a picture book aloud to a small circle of children',
	},
];

const gallery = [
	{
		img: '/images/homepage/parents-swinging-toddler.jpg',
		alt: 'Two parents swinging a laughing toddler between them in a garden',
		ratio: '3-4',
	},
	{
		img: '/images/homepage/nanny-kids-playing-balls.jpg',
		alt: 'A caregiver playing with two toddlers among scattered colorful balls',
		ratio: '4-3',
	},
	{
		img: '/images/homepage/child-pointing-geese.jpg',
		alt: "A caregiver holding a young boy's hand as he points out geese by a pond",
		ratio: '3-4',
	},
	{
		img: '/images/homepage/family-pond-geese.jpg',
		alt: 'A family of three pausing together beside a pond lined with autumn trees',
		ratio: '4-3',
	},
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<UtilityBar />

		<!-- Nav + hero share a grid stack so the pill nav floats over the photo -->
		<div class="hero-stack">
			<Nav overlay />
			<section class="hero" aria-label="Introduction">
				<img
					class="hero__media"
					src="/OPT-SSN-3-1_103.jpg"
					width="1920"
					height="1281"
					alt="A Triangle family sitting together in a garden, kids and parents laughing as bubbles float around them"
					fetchpriority="high"
					loading="eager"
				/>
				<div class="hero__scrim" aria-hidden="true"></div>
				<div class="container hero__content">
					<h1>Connecting vibrant families with extraordinary Triangle caregivers.</h1>
					<p class="lede hero__lede">
						We've been matching Triangle families with nannies they actually trust for more
						than 15 years. Raleigh, Durham, Chapel Hill, Cary, and everywhere in between.
					</p>
					<div class="hero__actions">
						<a class="btn btn-primary" href="/get-started">Start Your Search</a>
					</div>
					<a class="link-arrow hero__secondary" href="/candidates">Looking for nanny work? →</a>
				</div>
			</section>
		</div>

		<main id="main">
			<TestimonialSlider />

			<!-- Trust strip -->
			<section class="trust-strip" aria-label="Why families trust Triangle Nannies">
				<div class="container trust-strip__inner">
					{
						trustStrip.map((item, i) => (
							<div class="trust-strip__item reveal" style={`--reveal-delay:${i * 80}ms`}>
								<svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true">
									<path
										d={item.icon}
										stroke="currentColor"
										stroke-width="1.8"
										stroke-linecap="round"
										stroke-linejoin="round"
									/>
								</svg>
								<span>{item.text}</span>
							</div>
						))
					}
				</div>
			</section>

			<!-- Sound Familiar -->
			<section class="section section--cream">
				<div class="container grid grid-2">
					<div class="collage reveal">
						<div class="collage__main">
							<Photo
								ratio="3-4"
								src="/images/homepage/parent-phone-baby.jpg"
								alt="A parent holding a baby close at home while checking their phone"
								objectPosition="center 25%"
							/>
						</div>
						<div class="collage__inset">
							<Photo
								ratio="1-1"
								src="/images/homepage/nanny-kids-playing-balls.jpg"
								alt="A caregiver playing with two toddlers among scattered colorful balls"
								objectPosition="center 30%"
							/>
						</div>
					</div>
					<div class="reveal" style="--reveal-delay:120ms">
						<span class="eyebrow">For Families</span>
						<h2>Most families come to us after something stopped working.</h2>
						<p class="lede">
							The daycare waitlist that never cleared. The schedule that became impossible the
							second school let out early. The care that fell through with two days' notice. We
							know how to help from that exact moment.
						</p>
						<ul class="checklist">
							{
								soundFamiliar.map((item) => (
									<li>
										<svg width="20" height="20" viewBox="0 0 24 24" fill="none" aria-hidden="true">
											<path
												d="M5 13l4 4L19 7"
												stroke="currentColor"
												stroke-width="2.2"
												stroke-linecap="round"
												stroke-linejoin="round"
											/>
										</svg>
										<span>{item}</span>
									</li>
								))
							}
						</ul>
						<a class="btn btn-primary" href="/families">See How We Match Families</a>
					</div>
				</div>
			</section>

			<!-- Service cards -->
			<section class="section">
				<div class="container">
					<div class="section-head section-head--center reveal">
						<span class="eyebrow">What We Place</span>
						<h2>Whatever your household needs, we've placed it.</h2>
					</div>
					<div class="service-grid">
						{
							services.map((service, i) => (
								<a
									class="service-card reveal"
									href={service.href}
									style={`--reveal-delay:${(i % 3) * 90}ms`}
								>
									<div class="service-card__media">
										<Photo ratio="4-3" src={service.img} alt={service.alt} />
									</div>
									<div class="service-card__body">
										<h3>{service.name}</h3>
										<p>{service.description}</p>
										<span class="link-arrow service-card__cta">
											Learn More <span aria-hidden="true">→</span>
										</span>
									</div>
								</a>
							))
						}
					</div>
				</div>
			</section>

			<!-- Statement band -->
			<section class="statement-band">
				<div class="container statement-band__inner">
					<p class="statement-band__figure reveal">
						<span class="statement-band__number">15</span>
						<span class="statement-band__plus" aria-hidden="true">+</span>
					</p>
					<div class="statement-band__copy reveal" style="--reveal-delay:120ms">
						<h2>Years matching Triangle families with nannies they trust.</h2>
						<p class="lede">
							Raleigh, Durham, Chapel Hill, Cary, and everywhere in between. One conversation to
							start.
						</p>
						<a class="btn btn-primary" href="/get-started">Start Your Search</a>
					</div>
				</div>
			</section>

			<!-- How Placement Works -->
			<section class="section section--sage">
				<div class="container">
					<div class="section-head reveal">
						<span class="eyebrow">The Process</span>
						<h2>Finding the right nanny takes more than a resume review.</h2>
						<p class="lede">
							We interview every candidate in person, verify references by phone, and run a
							comprehensive background check before any introduction is made. Then we match on
							the details that actually matter: your schedule, your household, your kids'
							personalities, even the family with three kittens if that's a dealbreaker.
						</p>
					</div>
					<div class="step-grid">
						{
							steps.map((step, i) => (
								<div class="step reveal" style={`--reveal-delay:${i * 110}ms`}>
									<div class="step__media">
										<Photo ratio="4-3" src={step.img} alt={step.alt} />
										<span class="step__number">{step.n}</span>
									</div>
									<h3>{step.title}</h3>
									<p>{step.body}</p>
								</div>
							))
						}
					</div>
					<div class="step-grid__cta reveal">
						<a class="btn btn-primary" href="/how-it-works">See the Full Process</a>
					</div>
				</div>
			</section>

			<!-- Gallery strip -->
			<section class="gallery" aria-label="Life with a Triangle Nannies caregiver">
				<div class="container">
					<div class="gallery__head reveal">
						<span class="eyebrow">Everyday Moments</span>
						<h2>The ordinary days are the whole point.</h2>
					</div>
					<div class="gallery__grid">
						{
							gallery.map((shot, i) => (
								<div class="gallery__item reveal" style={`--reveal-delay:${i * 90}ms`}>
									<Photo ratio={shot.ratio as '3-4' | '4-3'} src={shot.img} alt={shot.alt} />
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- Split CTA banner -->
			<section class="split-cta">
				<div class="split-cta__panel split-cta__panel--families">
					<div class="split-cta__content reveal">
						<h2>Ready to find your match?</h2>
						<p>Tell us what your family needs and we'll take it from there.</p>
						<a class="btn btn-primary" href="/get-started">Start Your Search</a>
					</div>
				</div>
				<div class="split-cta__panel split-cta__panel--candidates">
					<div class="split-cta__content reveal" style="--reveal-delay:120ms">
						<h2>Your next great family is waiting.</h2>
						<p>And we do the work to make sure they're ready for you, too.</p>
						<a class="btn btn-primary" href="/apply">Apply to Join Our Network</a>
					</div>
				</div>
			</section>

			<!-- Meet Austin -->
			<section class="section section--plum">
				<div class="container grid grid-2">
					<div class="reveal">
						<ImagePlaceholder
							ratio="1-1"
							variant={6}
							label="Photo: Austin Macfarlane, founder of Triangle Nannies, 900x900"
						/>
					</div>
					<div class="reveal" style="--reveal-delay:120ms">
						<span class="eyebrow">Meet the Founder</span>
						<blockquote class="pull-quote">
							"I can always tell when a parent is white-knuckling through the call. They ask
							logistics questions right away because logistics feel safer than the thing they
							actually want to say: I don't know how to trust a stranger with my child."
						</blockquote>
						<p>
							Austin Macfarlane started Triangle Nannies after spending years trying to find
							reliable childcare for her own family. That experience is in the DNA of every
							placement we make.
						</p>
						<a class="btn btn-outline" href="/about">Read Austin's Story</a>
					</div>
				</div>
			</section>

			<!-- Trusted By / Community -->
			<section class="section">
				<div class="container">
					<div class="section-head section-head--center reveal">
						<span class="eyebrow">In the Community</span>
						<h2>Proud to be part of the Triangle.</h2>
					</div>
					<div class="logo-row" aria-label="Community partners, coming soon">
						{
							Array.from({ length: 5 }).map((_, i) => (
								<div class="logo-frame reveal" style={`--reveal-delay:${i * 80}ms`}>
									<span aria-hidden="true">Partner logo</span>
								</div>
							))
						}
					</div>
				</div>
			</section>

			<!-- Testimonials -->
			<section class="section section--cream">
				<div class="container">
					<div class="section-head section-head--center reveal">
						<span class="eyebrow">What Families Say</span>
					</div>
					<div class="testimonial-row reveal" style="--reveal-delay:120ms">
						<figure class="card testimonial-card">
							<span class="testimonial-card__tag">Sample review, replace with real content</span>
							<blockquote>
								"This is placeholder testimonial copy standing in for a real Google Business
								Profile review. Swap this card for live review content before launch."
							</blockquote>
							<figcaption>Placeholder Reviewer, Cary, NC</figcaption>
						</figure>
					</div>
				</div>
			</section>

			<!-- Final CTA band -->
			<section class="section section--plum final-cta">
				<div class="container final-cta__inner reveal">
					<h2>Let's find the right person for your family.</h2>
					<p class="lede">Fifteen years in the Triangle. One conversation to start.</p>
					<a class="btn btn-primary" href="/get-started">Get Started</a>
				</div>
			</section>
		</main>

		<Footer />
		<Reveal />

		<style>
			/* Hero: nav and photo share one grid cell so the pill nav floats over the image */
			.hero-stack {
				display: grid;
				background: var(--cream);
				padding: 0.75rem;
			}

			@media (min-width: 700px) {
				.hero-stack {
					padding: 1.25rem;
				}
			}

			.hero-stack > :global(*) {
				grid-area: 1 / 1;
			}

			.hero-stack > :global(.site-header--overlay) {
				z-index: 10;
				padding-inline: 0.75rem;
			}

			.hero {
				position: relative;
				min-height: 34rem;
				display: flex;
				align-items: flex-end;
				justify-content: center;
				border-radius: var(--radius-lg);
				overflow: hidden;
				isolation: isolate;
			}

			@media (min-width: 700px) {
				.hero {
					min-height: 44rem;
				}
			}

			.hero__media {
				position: absolute;
				inset: 0;
				z-index: 0;
				width: 100%;
				height: 100%;
				object-fit: cover;
				object-position: center 20%;
				background: linear-gradient(135deg, var(--terracotta), var(--plum) 65%);
			}

			.hero__scrim {
				position: absolute;
				inset: 0;
				z-index: 1;
				background:
					linear-gradient(0deg, rgba(20, 12, 8, 0.8) 0%, rgba(20, 12, 8, 0.45) 42%, rgba(20, 12, 8, 0.22) 68%, rgba(20, 12, 8, 0.15) 100%),
					linear-gradient(180deg, rgba(20, 12, 8, 0.35) 0%, rgba(20, 12, 8, 0.1) 30%, rgba(20, 12, 8, 0) 55%);
			}

			.hero__content {
				position: relative;
				z-index: 2;
				padding-block: 6.5rem 2.5rem;
				max-width: 72rem;
				margin-inline: auto;
				color: var(--white);
				text-align: center;
			}

			.hero__content h1 {
				color: var(--white);
				font-size: clamp(2.1rem, 4.6vw, 3.75rem);
				text-shadow: 0 2px 20px rgba(0, 0, 0, 0.35);
			}

			.hero__lede {
				color: rgba(255, 255, 255, 0.95);
				max-width: 46ch;
				margin-inline: auto;
				text-shadow: 0 1px 12px rgba(0, 0, 0, 0.4);
			}

			.hero__actions {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 1.5rem;
				flex-wrap: wrap;
				margin-top: 1.75rem;
			}

			.hero__secondary {
				display: inline-flex;
				margin-top: 1rem;
				color: var(--white);
			}

			.hero__secondary:hover {
				color: var(--gold);
			}

			@media (min-width: 700px) {
				.hero__content {
					padding-block: 7.5rem 3.5rem;
				}
			}

			/* Trust strip */
			.trust-strip {
				background: var(--white);
				border-block: 1px solid var(--sage);
				padding-block: 2rem;
			}

			.trust-strip__inner {
				display: grid;
				gap: 1.25rem 2rem;
				grid-template-columns: 1fr;
			}

			@media (min-width: 700px) {
				.trust-strip__inner {
					grid-template-columns: repeat(2, 1fr);
				}
			}

			@media (min-width: 1100px) {
				.trust-strip__inner {
					grid-template-columns: repeat(4, 1fr);
				}
			}

			.trust-strip__item {
				display: flex;
				align-items: flex-start;
				gap: 0.75rem;
				font-size: 0.92rem;
				font-weight: 500;
				color: var(--text-dark);
			}

			.trust-strip__item svg {
				flex-shrink: 0;
				color: var(--terracotta-dark);
				margin-top: 0.15rem;
			}

			/* Sound familiar */
			.collage {
				position: relative;
				padding-bottom: 3.5rem;
				padding-right: 2.5rem;
			}

			.collage__main {
				width: 88%;
			}

			.collage__inset {
				position: absolute;
				right: 0;
				bottom: 0;
				width: 46%;
				border-radius: calc(var(--radius-lg) + 6px);
				overflow: hidden;
				border: 6px solid var(--cream);
				box-shadow: var(--shadow-soft);
			}

			@media (min-width: 900px) {
				.collage {
					padding-bottom: 4.5rem;
				}
			}

			.checklist {
				list-style: none;
				display: flex;
				flex-direction: column;
				gap: 0.85rem;
				margin: 1.75rem 0 2.25rem;
			}

			.checklist li {
				display: flex;
				align-items: flex-start;
				gap: 0.75rem;
			}

			.checklist svg {
				flex-shrink: 0;
				color: var(--terracotta-dark);
				margin-top: 0.2rem;
			}

			/* Service cards */
			.service-grid {
				display: grid;
				gap: 2rem;
				grid-template-columns: 1fr;
			}

			@media (min-width: 640px) {
				.service-grid {
					grid-template-columns: repeat(2, 1fr);
				}
			}

			@media (min-width: 1024px) {
				.service-grid {
					grid-template-columns: repeat(3, 1fr);
				}
			}

			.service-card {
				display: flex;
				flex-direction: column;
				height: 100%;
				background: var(--white);
				border-radius: var(--radius-lg);
				box-shadow: var(--shadow-card);
				overflow: hidden;
				text-decoration: none;
				color: inherit;
				transition:
					transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
					box-shadow 0.3s ease;
			}

			.service-card:hover {
				transform: translateY(-6px);
				box-shadow: 0 20px 44px rgba(44, 31, 23, 0.16);
				color: inherit;
			}

			.service-card__media {
				overflow: hidden;
			}

			.service-card__media :global(.ph),
			.service-card__media :global(.media) {
				border-radius: 0;
				transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
			}

			.service-card:hover .service-card__media :global(.ph),
			.service-card:hover .service-card__media :global(.media) {
				transform: scale(1.05);
			}

			.service-card__body {
				display: flex;
				flex-direction: column;
				gap: 0.6rem;
				padding: 1.6rem 1.75rem 1.9rem;
				flex-grow: 1;
			}

			.service-card__body h3 {
				margin: 0;
			}

			.service-card__body p {
				color: var(--text-muted);
				margin: 0;
				flex-grow: 1;
			}

			.service-card__cta {
				margin-top: 0.4rem;
			}

			.service-card:hover .service-card__cta {
				color: var(--terracotta-dark);
			}

			/* Statement band */
			.statement-band {
				background: var(--plum);
				color: var(--white);
				padding: 4.5rem 0;
			}

			@media (min-width: 768px) {
				.statement-band {
					padding: 6.5rem 0;
				}
			}

			.statement-band__inner {
				display: grid;
				gap: 2rem;
				align-items: center;
			}

			@media (min-width: 900px) {
				.statement-band__inner {
					grid-template-columns: auto 1fr;
					gap: 4.5rem;
				}
			}

			.statement-band__figure {
				display: flex;
				align-items: flex-start;
				color: var(--gold);
				line-height: 0.85;
			}

			.statement-band__number {
				font-family: var(--font-head);
				font-weight: 700;
				font-size: clamp(6rem, 16vw, 13rem);
				letter-spacing: -0.02em;
			}

			.statement-band__plus {
				font-family: var(--font-head);
				font-weight: 700;
				font-size: clamp(2.5rem, 6vw, 5rem);
				margin-top: 0.35em;
			}

			.statement-band__copy h2 {
				color: var(--white);
				max-width: 26ch;
			}

			.statement-band__copy .lede {
				color: rgba(255, 255, 255, 0.85);
				max-width: 46ch;
				margin-bottom: 2rem;
			}

			/* Process steps */
			.step-grid {
				display: grid;
				gap: 2.5rem;
				grid-template-columns: 1fr;
			}

			@media (min-width: 800px) {
				.step-grid {
					grid-template-columns: repeat(3, 1fr);
				}
			}

			.step__media {
				position: relative;
				margin-bottom: 1.5rem;
			}

			.step__number {
				position: absolute;
				top: 1rem;
				right: 1rem;
				display: flex;
				align-items: center;
				justify-content: center;
				width: 3.4rem;
				height: 3.4rem;
				border-radius: 999px;
				background: var(--plum);
				color: var(--white);
				font-family: var(--font-head);
				font-weight: 700;
				font-size: 1.1rem;
				box-shadow: var(--shadow-soft);
			}

			.step h3 {
				margin-bottom: 0.5rem;
			}

			.step p {
				color: #5d5145;
				margin: 0;
			}

			.step-grid__cta {
				margin-top: 3rem;
			}

			/* Gallery strip */
			.gallery {
				padding: 4.5rem 0;
				background: var(--white);
			}

			@media (min-width: 768px) {
				.gallery {
					padding: 7rem 0;
				}
			}

			.gallery__head {
				max-width: 46rem;
				margin-bottom: 2.75rem;
			}

			.gallery__grid {
				display: grid;
				gap: 1.5rem;
				grid-template-columns: repeat(2, 1fr);
			}

			@media (min-width: 900px) {
				.gallery__grid {
					grid-template-columns: repeat(4, 1fr);
					align-items: center;
				}

				/* Offset alternating tiles so the row feels composed, not gridded.
				   Uses margin, not transform, so it does not fight the reveal animation. */
				.gallery__item:nth-child(even) {
					margin-top: 3rem;
				}
			}

			/* Split CTA */
			.split-cta {
				display: grid;
				grid-template-columns: 1fr;
			}

			@media (min-width: 800px) {
				.split-cta {
					grid-template-columns: 1fr 1fr;
				}
			}

			.split-cta__panel {
				padding: 4.5rem 1.25rem;
				display: flex;
				align-items: center;
				justify-content: center;
			}

			.split-cta__panel--families {
				background: var(--terracotta);
				color: var(--white);
			}

			.split-cta__panel--candidates {
				background: var(--sage);
				color: var(--text-dark);
			}

			.split-cta__content {
				max-width: 26rem;
				text-align: center;
			}

			.split-cta__panel--families h2 {
				color: var(--white);
			}

			.split-cta__content p {
				margin-bottom: 1.75rem;
			}

			/* Meet Austin */
			.pull-quote {
				font-family: var(--font-head);
				font-size: clamp(1.35rem, 2.2vw, 1.75rem);
				font-weight: 500;
				line-height: 1.4;
				margin: 0 0 1.75rem;
				padding: 0;
				border: none;
				color: var(--white);
			}

			/* Community logos */
			.logo-row {
				display: grid;
				gap: 1.25rem;
				grid-template-columns: repeat(2, 1fr);
			}

			@media (min-width: 700px) {
				.logo-row {
					grid-template-columns: repeat(5, 1fr);
				}
			}

			.logo-frame {
				aspect-ratio: 3 / 2;
				border: 1.5px dashed var(--sage);
				border-radius: var(--radius-md);
				display: flex;
				align-items: center;
				justify-content: center;
				color: var(--text-muted);
				font-size: 0.8rem;
			}

			/* Testimonials */
			.testimonial-row {
				display: flex;
				justify-content: center;
			}

			.testimonial-card {
				max-width: 34rem;
				text-align: center;
				position: relative;
				padding: 2.25rem;
			}

			.testimonial-card__tag {
				display: inline-block;
				background: var(--gold);
				color: var(--text-dark);
				font-size: 0.72rem;
				font-weight: 700;
				text-transform: uppercase;
				letter-spacing: 0.06em;
				padding: 0.3em 0.8em;
				border-radius: 999px;
				margin-bottom: 1.25rem;
			}

			.testimonial-card blockquote {
				margin: 0 0 1.25rem;
				font-size: 1.15rem;
				line-height: 1.6;
				color: var(--text-dark);
			}

			.testimonial-card figcaption {
				color: var(--text-muted);
				font-size: 0.9rem;
			}

			/* Final CTA */
			.final-cta__inner {
				text-align: center;
				max-width: 46rem;
			}

			.final-cta__inner p {
				margin-bottom: 2rem;
			}
		</style>
	</body>
</html>
