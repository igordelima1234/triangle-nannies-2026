<style>
	.utility-bar {
		background: var(--plum);
		color: rgba(255, 255, 255, 0.85);
		font-size: 0.8rem;
		position: relative;
		z-index: 110;
	}

	.utility-bar__inner {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem 1.5rem;
		padding-block: 0.5rem;
		flex-wrap: wrap;
		text-align: center;
	}

	.utility-bar a {
		color: inherit;
		text-decoration: none;
	}

	.utility-bar a:hover {
		color: var(--gold);
	}

	.utility-bar__area {
		display: none;
	}

	@media (min-width: 700px) {
		.utility-bar__inner {
			justify-content: space-between;
		}
		.utility-bar__area {
			display: inline;
		}
	}
</style>
