---
interface Props {
	label: string;
	ratio?: '4-3' | '1-1' | '3-4' | '16-9';
	class?: string;
}

const { label, ratio = '4-3', class: className = '' } = Astro.props;
---

<div
	class:list={['img-placeholder', `aspect-${ratio}`, className]}
	role="img"
	aria-label={label}
>
	<span class="img-placeholder__label" aria-hidden="true">{label}</span>
</div>
