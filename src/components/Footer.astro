---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="container footer-top">
		<div class="footer-brand">
			<p class="footer-brand__name">Triangle Nannies &amp; Household Staffing</p>
			<p class="footer-newsletter-copy">
				Triangle parenting tips, local recommendations, and the occasional nanny-search reality
				check. No spam, promise.
			</p>
			<form class="newsletter-form" aria-label="Newsletter signup">
				<label class="sr-only" for="newsletter-email">Email address</label>
				<input
					id="newsletter-email"
					type="email"
					name="email"
					placeholder="you@email.com"
					required
				/>
				<button type="submit" class="btn btn-primary">Sign Up</button>
			</form>
		</div>

		<nav class="footer-col" aria-labelledby="footer-families">
			<h3 id="footer-families">Families</h3>
			<ul>
				<li><a href="/how-it-works">How It Works</a></li>
				<li><a href="/services">Services</a></li>
				<li><a href="/pricing">Pricing</a></li>
				<li><a href="/faq">FAQ</a></li>
			</ul>
		</nav>

		<nav class="footer-col" aria-labelledby="footer-candidates">
			<h3 id="footer-candidates">Candidates</h3>
			<ul>
				<li><a href="/apply">Apply Now</a></li>
				<li><a href="/what-to-expect">What to Expect</a></li>
				<li><a href="/faq">FAQ</a></li>
			</ul>
		</nav>

		<nav class="footer-col" aria-labelledby="footer-company">
			<h3 id="footer-company">Company</h3>
			<ul>
				<li><a href="/about">About Austin</a></li>
				<li><a href="/blog">Blog</a></li>
				<li><a href="/contact">Contact</a></li>
				<li><a href="/careers">Careers at TN</a></li>
			</ul>
		</nav>

		<nav class="footer-col" aria-labelledby="footer-connect">
			<h3 id="footer-connect">Connect</h3>
			<ul>
				<li><a href="https://instagram.com" target="_blank" rel="noopener noreferrer">Instagram</a></li>
				<li><a href="https://facebook.com" target="_blank" rel="noopener noreferrer">Facebook</a></li>
				<li><a href="#newsletter-email">Newsletter</a></li>
			</ul>
		</nav>
	</div>

	<div class="container footer-bottom">
		<p>
			&copy; {year} Triangle Nannies &amp; Household Staffing. Serving Raleigh, Durham, Chapel Hill,
			Cary &amp; the Triangle.
		</p>
		<div class="footer-legal">
			<a href="/privacy">Privacy Policy</a>
			<a href="/terms">Terms</a>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--plum);
		color: rgba(255, 255, 255, 0.85);
	}

	.footer-top {
		display: grid;
		gap: 2.5rem;
		padding-block: 4rem 3rem;
		grid-template-columns: 1fr;
	}

	.footer-brand__name {
		font-family: var(--font-head);
		font-weight: 700;
		font-size: 1.15rem;
		text-transform: uppercase;
		color: var(--white);
		margin-bottom: 1rem;
	}

	.footer-newsletter-copy {
		max-width: 34ch;
		font-size: 0.95rem;
	}

	.newsletter-form {
		display: flex;
		gap: 0.5rem;
		flex-wrap: wrap;
		margin-top: 1rem;
	}

	.newsletter-form input {
		flex: 1 1 200px;
		padding: 0.75em 1em;
		border-radius: 999px;
		border: 1px solid rgba(255, 255, 255, 0.3);
		background: rgba(255, 255, 255, 0.08);
		color: var(--white);
		font-family: var(--font-body);
		font-size: 0.95rem;
	}

	.newsletter-form input::placeholder {
		color: rgba(255, 255, 255, 0.55);
	}

	.footer-col h3 {
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 0.85rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--gold);
		margin-bottom: 1rem;
	}

	.footer-col ul {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}

	.footer-col a {
		color: rgba(255, 255, 255, 0.85);
		text-decoration: none;
		font-size: 0.95rem;
	}

	.footer-col a:hover {
		color: var(--gold);
	}

	.footer-bottom {
		border-top: 1px solid rgba(255, 255, 255, 0.15);
		padding-block: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		font-size: 0.8rem;
		color: rgba(255, 255, 255, 0.7);
	}

	.footer-legal {
		display: flex;
		gap: 1.25rem;
	}

	.footer-legal a {
		color: rgba(255, 255, 255, 0.7);
		text-decoration: underline;
	}

	.footer-legal a:hover {
		color: var(--gold);
	}

	@media (min-width: 700px) {
		.footer-bottom {
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
		}
	}

	@media (min-width: 900px) {
		.footer-top {
			grid-template-columns: 1.6fr 1fr 1fr 1fr 1fr;
		}
	}
</style>
