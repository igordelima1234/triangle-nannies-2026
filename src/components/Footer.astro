---
const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-inner footer-wordmark-row">
		<p class="footer-wordmark">Triangle Nannies</p>
	</div>

	<hr class="footer-divider" />

	<div class="footer-inner footer-intro">
		<p class="footer-tagline">More time for what matters.</p>
		<div class="footer-newsletter">
			<p class="footer-newsletter-copy">
				Triangle parenting tips, local recommendations, and the occasional nanny-search reality
				check. No spam, promise.
			</p>
			<form class="newsletter-form" aria-label="Newsletter signup">
				<label class="sr-only" for="newsletter-email">Email address</label>
				<input
					id="newsletter-email"
					type="email"
					name="email"
					placeholder="email"
					required
				/>
				<button type="submit" class="newsletter-form__submit">Subscribe</button>
			</form>
		</div>
	</div>

	<div class="footer-inner footer-columns">
		<nav class="footer-col" aria-labelledby="footer-families">
			<h3 id="footer-families">Families</h3>
			<ul>
				<li><a href="/how-it-works">How It Works</a></li>
				<li><a href="/services">Services</a></li>
				<li><a href="/pricing">Pricing</a></li>
				<li><a href="/faq">FAQ</a></li>
			</ul>
		</nav>

		<nav class="footer-col" aria-labelledby="footer-candidates">
			<h3 id="footer-candidates">Candidates</h3>
			<ul>
				<li><a href="/apply">Apply Now</a></li>
				<li><a href="/what-to-expect">What to Expect</a></li>
				<li><a href="/faq">FAQ</a></li>
			</ul>
		</nav>

		<nav class="footer-col" aria-labelledby="footer-company">
			<h3 id="footer-company">Company</h3>
			<ul>
				<li><a href="/about">About Austin</a></li>
				<li><a href="/blog">Blog</a></li>
				<li><a href="/contact">Contact</a></li>
				<li><a href="/careers">Careers at TN</a></li>
			</ul>
		</nav>

		<nav class="footer-col" aria-labelledby="footer-connect">
			<h3 id="footer-connect">Connect</h3>
			<ul>
				<li><a href="https://instagram.com" target="_blank" rel="noopener noreferrer">Instagram</a></li>
				<li><a href="https://facebook.com" target="_blank" rel="noopener noreferrer">Facebook</a></li>
				<li><a href="#newsletter-email">Newsletter</a></li>
			</ul>
		</nav>
	</div>

	<div class="footer-inner footer-mark-row">
		<div class="footer-badge" aria-hidden="true">TN</div>
	</div>

	<div class="footer-inner footer-bottom">
		<p>
			&copy; {year} Triangle Nannies &amp; Household Staffing. Serving Raleigh, Durham, Chapel Hill,
			Cary &amp; the Triangle.
		</p>
		<div class="footer-legal">
			<a href="/privacy">Privacy Policy</a>
			<a href="/terms">Terms of Service</a>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--plum);
		color: rgba(255, 255, 255, 0.85);
		overflow: hidden;
	}

	.footer-inner {
		width: 100%;
		max-width: 1600px;
		margin-inline: auto;
		padding-inline: 1.25rem;
	}

	@media (min-width: 768px) {
		.footer-inner {
			padding-inline: 2.5rem;
		}
	}

	.footer-wordmark-row {
		padding-block: 2.5rem 2rem;
	}

	.footer-wordmark {
		font-family: var(--font-head);
		font-weight: 700;
		font-size: clamp(2.25rem, 7vw, 4.75rem);
		line-height: 1;
		text-transform: uppercase;
		letter-spacing: 0.01em;
		color: var(--white);
		margin: 0;
	}

	.footer-divider {
		border: none;
		border-top: 1px solid rgba(255, 255, 255, 0.25);
		margin: 0;
	}

	.footer-intro {
		display: grid;
		gap: 1.75rem;
		padding-block: 2.5rem;
	}

	@media (min-width: 800px) {
		.footer-intro {
			grid-template-columns: 1fr 1.1fr;
			align-items: start;
			gap: 3rem;
		}
	}

	.footer-tagline {
		font-family: var(--font-head);
		font-weight: 700;
		font-size: clamp(1.5rem, 3vw, 2.25rem);
		text-transform: uppercase;
		letter-spacing: 0.01em;
		color: var(--white);
		margin: 0;
		max-width: 14ch;
	}

	.footer-newsletter-copy {
		max-width: 40ch;
		font-size: 0.95rem;
		margin: 0 0 1.25rem;
	}

	.newsletter-form {
		display: flex;
		align-items: flex-end;
		gap: 1.25rem;
		flex-wrap: wrap;
	}

	.newsletter-form input {
		flex: 1 1 220px;
		padding: 0.5em 0;
		background: transparent;
		border: none;
		border-bottom: 1px solid rgba(255, 255, 255, 0.4);
		color: var(--white);
		font-family: var(--font-body);
		font-size: 1rem;
	}

	.newsletter-form input::placeholder {
		color: rgba(255, 255, 255, 0.55);
	}

	.newsletter-form__submit {
		flex-shrink: 0;
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 0.85rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		background: transparent;
		color: var(--white);
		border: 1.5px solid rgba(255, 255, 255, 0.6);
		border-radius: 999px;
		padding: 0.85em 1.9em;
		cursor: pointer;
		transition:
			background-color 0.15s ease,
			color 0.15s ease;
	}

	.newsletter-form__submit:hover {
		background: var(--white);
		color: var(--plum);
	}

	.footer-columns {
		display: grid;
		gap: 2.5rem;
		grid-template-columns: repeat(2, 1fr);
		padding-block: 1rem 3rem;
	}

	@media (min-width: 700px) {
		.footer-columns {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	.footer-col h3 {
		font-family: var(--font-body);
		font-weight: 700;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--white);
		margin-bottom: 1rem;
	}

	.footer-col ul {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}

	.footer-col a {
		color: rgba(255, 255, 255, 0.8);
		text-decoration: none;
		font-size: 0.95rem;
	}

	.footer-col a:hover {
		color: var(--gold);
	}

	.footer-mark-row {
		display: flex;
		justify-content: center;
		padding-block: 1rem 3rem;
	}

	.footer-badge {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 5.5rem;
		height: 5.5rem;
		border-radius: 999px;
		border: 1.5px solid rgba(255, 255, 255, 0.4);
		font-family: var(--font-head);
		font-weight: 700;
		font-size: 1.35rem;
		letter-spacing: 0.02em;
		color: var(--white);
	}

	.footer-bottom {
		border-top: 1px solid rgba(255, 255, 255, 0.15);
		padding-block: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		font-size: 0.78rem;
		letter-spacing: 0.01em;
		color: rgba(255, 255, 255, 0.65);
	}

	.footer-legal {
		display: flex;
		gap: 1.25rem;
	}

	.footer-legal a {
		color: rgba(255, 255, 255, 0.65);
		text-decoration: underline;
	}

	.footer-legal a:hover {
		color: var(--gold);
	}

	@media (min-width: 700px) {
		.footer-bottom {
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
		}
	}
</style>
