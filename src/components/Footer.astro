---
import { SITE_TITLE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="footer-inner footer-wordmark-row">
		<img class="footer-wordmark" src="/images/logos/tn-logo-full-light.svg" alt={SITE_TITLE} width="874" height="200" />

		<div class="footer-social">
			<span class="footer-social__label">Follow Along</span>
			<div class="footer-social__icons">
				<a href="https://instagram.com" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
						<rect x="2.5" y="2.5" width="19" height="19" rx="5" />
						<circle cx="12" cy="12" r="4.5" />
						<circle cx="17.3" cy="6.7" r="1.1" fill="currentColor" stroke="none" />
					</svg>
				</a>
				<a href="https://facebook.com" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
						<path d="M14.5 21v-7.5h2.5l.5-3h-3V8.3c0-.87.24-1.46 1.5-1.46H17.5V4.14C17.24 4.1 16.35 4 15.32 4c-2.15 0-3.62 1.31-3.62 3.72V10.5H9.2v3h2.5V21h2.8Z" />
					</svg>
				</a>
				<a href="https://youtube.com" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
						<rect x="2.5" y="5.5" width="19" height="13" rx="4" />
						<path d="M10.3 9.3v5.4l4.8-2.7-4.8-2.7Z" fill="currentColor" stroke="none" />
					</svg>
				</a>
				<a href="https://tiktok.com" target="_blank" rel="noopener noreferrer" aria-label="TikTok">
					<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.75">
						<path d="M16.5 3v9.7a3.3 3.3 0 1 1-3.3-3.3" />
						<path d="M16.5 3c.35 2.6 1.9 4.2 4.2 4.4" />
					</svg>
				</a>
			</div>
		</div>
	</div>

	<hr class="footer-divider" />

	<div class="footer-inner footer-intro">
		<p class="footer-tagline">Connecting vibrant families with extraordinary Triangle caregivers.</p>
		<div class="footer-newsletter">
			<p class="footer-newsletter-copy">
				Triangle parenting tips, local recommendations, and the occasional nanny-search reality
				check. No spam, promise.
			</p>
			<form class="newsletter-form" aria-label="Newsletter signup">
				<label class="sr-only" for="newsletter-email">Email address</label>
				<input
					id="newsletter-email"
					type="email"
					name="email"
					placeholder="email"
					required
				/>
				<button type="submit" class="newsletter-form__submit">Subscribe</button>
			</form>
		</div>
	</div>

	<div class="footer-inner footer-columns">
		<nav class="footer-col" aria-labelledby="footer-families">
			<h3 id="footer-families">Families</h3>
			<ul>
				<li><a href="/how-it-works">How It Works</a></li>
				<li><a href="/services">Services</a></li>
				<li><a href="/pricing">Pricing</a></li>
				<li><a href="/faq">FAQ</a></li>
			</ul>
		</nav>

		<nav class="footer-col" aria-labelledby="footer-candidates">
			<h3 id="footer-candidates">Candidates</h3>
			<ul>
				<li><a href="/apply">Apply Now</a></li>
				<li><a href="/what-to-expect">What to Expect</a></li>
				<li><a href="/faq">FAQ</a></li>
			</ul>
		</nav>

		<nav class="footer-col" aria-labelledby="footer-company">
			<h3 id="footer-company">Company</h3>
			<ul>
				<li><a href="/about">Our Team</a></li>
				<li><a href="/blog">Blog</a></li>
				<li><a href="/contact">Contact</a></li>
				<li><a href="/careers">Careers at TN</a></li>
			</ul>
		</nav>

		<nav class="footer-col" aria-labelledby="footer-connect">
			<h3 id="footer-connect">Connect</h3>
			<ul>
				<li><a href="https://instagram.com" target="_blank" rel="noopener noreferrer">Instagram</a></li>
				<li><a href="https://facebook.com" target="_blank" rel="noopener noreferrer">Facebook</a></li>
				<li><a href="#newsletter-email">Newsletter</a></li>
			</ul>
		</nav>
	</div>

	<div class="footer-inner footer-bottom">
		<p>
			&copy; {year} Triangle Nannies &amp; Household Staffing. Serving Raleigh, Durham, Chapel Hill,
			Cary &amp; the Triangle.
		</p>
		<div class="footer-legal">
			<a href="/privacy">Privacy Policy</a>
			<a href="/terms">Terms of Service</a>
		</div>
	</div>
</footer>

<style>
	.site-footer {
		background: var(--plum);
		color: rgba(255, 255, 255, 0.85);
		overflow: hidden;
	}

	.footer-inner {
		width: 100%;
		max-width: 1600px;
		margin-inline: auto;
		padding-inline: 1.25rem;
	}

	@media (min-width: 768px) {
		.footer-inner {
			padding-inline: 2.5rem;
		}
	}

	.footer-wordmark-row {
		padding-block: 2.5rem 2rem;
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.footer-wordmark {
		display: block;
		height: auto;
		width: clamp(14rem, 34vw, 24rem);
	}

	.footer-social {
		display: flex;
		align-items: center;
		gap: 0.9rem;
	}

	.footer-social__label {
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		color: rgba(255, 255, 255, 0.75);
	}

	.footer-social__icons {
		display: flex;
		align-items: center;
		gap: 0.65rem;
	}

	.footer-social__icons a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2rem;
		height: 2rem;
		border-radius: 999px;
		border: 1.5px solid rgba(255, 255, 255, 0.5);
		color: var(--white);
		transition:
			background-color 0.15s ease,
			color 0.15s ease,
			border-color 0.15s ease;
	}

	.footer-social__icons a:hover {
		background: var(--white);
		border-color: var(--white);
		color: var(--plum);
	}

	.footer-social__icons svg {
		width: 1.05rem;
		height: 1.05rem;
	}

	.footer-divider {
		border: none;
		border-top: 1px solid rgba(255, 255, 255, 0.25);
		margin: 0;
	}

	.footer-intro {
		display: grid;
		gap: 1.75rem;
		padding-block: 2.5rem;
	}

	@media (min-width: 800px) {
		.footer-intro {
			grid-template-columns: 1fr 1.1fr;
			align-items: start;
			gap: 3rem;
		}
	}

	.footer-tagline {
		font-family: var(--font-head);
		font-weight: 600;
		font-size: clamp(1.75rem, 3.5vw, 2.6rem);
		line-height: 1.05;
		letter-spacing: -0.5px;
		color: var(--white);
		margin: 0;
		max-width: 22ch;
	}

	.footer-newsletter-copy {
		max-width: 40ch;
		font-size: 0.95rem;
		margin: 0 0 1.25rem;
	}

	.newsletter-form {
		display: flex;
		align-items: flex-end;
		gap: 1.25rem;
		flex-wrap: wrap;
	}

	.newsletter-form input {
		flex: 1 1 220px;
		padding: 0.5em 0;
		background: transparent;
		border: none;
		border-bottom: 1px solid rgba(255, 255, 255, 0.4);
		color: var(--white);
		font-family: var(--font-body);
		font-size: 1rem;
	}

	.newsletter-form input::placeholder {
		color: rgba(255, 255, 255, 0.55);
	}

	.newsletter-form__submit {
		flex-shrink: 0;
		font-family: var(--font-body);
		font-weight: 600;
		font-size: 0.85rem;
		letter-spacing: 0.04em;
		text-transform: uppercase;
		background: transparent;
		color: var(--white);
		border: 1.5px solid rgba(255, 255, 255, 0.6);
		border-radius: 999px;
		padding: 0.85em 1.9em;
		cursor: pointer;
		transition:
			background-color 0.15s ease,
			color 0.15s ease;
	}

	.newsletter-form__submit:hover {
		background: var(--white);
		color: var(--plum);
	}

	.footer-columns {
		display: grid;
		gap: 2.5rem;
		grid-template-columns: repeat(2, 1fr);
		padding-block: 1rem 3rem;
	}

	@media (min-width: 700px) {
		.footer-columns {
			grid-template-columns: repeat(4, 1fr);
		}
	}

	.footer-col h3 {
		font-family: var(--font-body);
		font-weight: 700;
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.1em;
		color: var(--white);
		margin-bottom: 1rem;
	}

	.footer-col ul {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.65rem;
	}

	.footer-col a {
		color: rgba(255, 255, 255, 0.8);
		text-decoration: none;
		font-size: 0.95rem;
	}

	.footer-col a:hover {
		color: var(--gold);
	}

	.footer-bottom {
		border-top: 1px solid rgba(255, 255, 255, 0.15);
		padding-block: 1.5rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
		font-size: 0.78rem;
		letter-spacing: 0.01em;
		color: rgba(255, 255, 255, 0.65);
	}

	.footer-legal {
		display: flex;
		gap: 1.25rem;
	}

	.footer-legal a {
		color: rgba(255, 255, 255, 0.65);
		text-decoration: underline;
	}

	.footer-legal a:hover {
		color: var(--gold);
	}

	@media (min-width: 700px) {
		.footer-bottom {
			flex-direction: row;
			justify-content: space-between;
			align-items: center;
		}
	}
</style>
