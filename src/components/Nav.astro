---
import HeaderLink from './HeaderLink.astro';
import { SITE_TITLE } from '../consts';

interface Props {
	overlay?: boolean;
}

const { overlay = false } = Astro.props;
---

<header class:list={['site-header', { 'site-header--overlay': overlay }]}>
	<div class="container site-header__inner">
		<a href="/" class="site-header__logo">
			<img src="/images/logos/tn-logo-full-light.svg" alt={SITE_TITLE} width="874" height="200" />
		</a>

		<button class="nav-toggle" id="nav-toggle" aria-expanded="false" aria-controls="primary-nav" aria-label="Open menu">
			<span class="nav-toggle__bars" aria-hidden="true">
				<span></span><span></span><span></span>
			</span>
		</button>

		<div class="nav-backdrop" id="nav-backdrop"></div>

		<nav class="primary-nav" id="primary-nav">
			<div class="primary-nav__header">
				<span class="primary-nav__header-label">Menu</span>
				<button class="nav-close" id="nav-close" aria-label="Close menu">
					<svg width="18" height="18" viewBox="0 0 18 18" fill="none" aria-hidden="true">
						<path d="M2 2l14 14M16 2L2 16" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
					</svg>
				</button>
			</div>
			<ul class="primary-nav__list">
				<li class="has-dropdown">
					<button class="primary-nav__link dropdown-trigger" aria-expanded="false" aria-controls="services-menu">
						Services
						<svg class="dropdown-chevron" width="12" height="8" viewBox="0 0 12 8" fill="none" aria-hidden="true">
							<path d="M1 1.5l5 5 5-5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" />
						</svg>
					</button>
					<ul class="dropdown-menu" id="services-menu">
						<li><a href="/services/full-time-nanny">Full-Time Nanny</a></li>
						<li><a href="/services/part-time-nanny">Part-Time Nanny</a></li>
						<li><a href="/services/newborn-care-specialist">Newborn Care Specialist</a></li>
						<li><a href="/services/backup-temp-care">Backup &amp; Temp Care</a></li>
						<li><a href="/services/doulas-newborn-support">Doulas &amp; Newborn Support</a></li>
					</ul>
				</li>
				<li><HeaderLink class="primary-nav__link" href="/families">Families</HeaderLink></li>
				<li><HeaderLink class="primary-nav__link" href="/candidates">Candidates</HeaderLink></li>
				<li><HeaderLink class="primary-nav__link" href="/about">About</HeaderLink></li>
				<li><HeaderLink class="primary-nav__link" href="/blog">Blog</HeaderLink></li>
				<li><HeaderLink class="primary-nav__link" href="/contact">Contact</HeaderLink></li>
			</ul>
			<div class="primary-nav__footer">
				<a href="tel:19195550100" class="nav-call">
					<svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true">
						<path d="M2.5 2.5c0-.5.4-1 1-1h1.8c.4 0 .8.3.9.7l.7 2.4c.1.4 0 .8-.3 1.1L5.4 6.9a9 9 0 0 0 3.7 3.7l1.2-1.2c.3-.3.7-.4 1.1-.3l2.4.7c.4.1.7.5.7.9v1.8c0 .6-.5 1-1 1C7.9 13.5 2.5 8.1 2.5 2.5z" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round"/>
					</svg>
					(919) 555-0100
				</a>
				<a href="/get-started" class="btn btn-primary nav-cta">Get Started</a>
			</div>
		</nav>
	</div>
</header>

<style>
	.site-header {
		background: var(--plum);
		position: sticky;
		top: 0;
		z-index: 120;
		box-shadow: 0 2px 12px rgba(44, 31, 23, 0.15);
	}

	.site-header__inner {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-block: 1rem;
	}

	@media (min-width: 960px) {
		.site-header__inner {
			display: grid;
			grid-template-columns: 1fr auto 1fr;
			align-items: center;
		}
	}

	.site-header__logo {
		display: inline-flex;
		align-items: center;
		flex-shrink: 0;
	}

	@media (min-width: 960px) {
		.site-header__logo {
			grid-column: 1;
			justify-self: start;
		}
	}

	.site-header__logo img {
		display: block;
		width: 220px;
		height: auto;
	}

	@media (min-width: 480px) {
		.site-header__logo img {
			width: 250px;
		}
	}

	@media (min-width: 960px) {
		.site-header__logo img {
			width: 300px;
		}
	}

	.nav-toggle {
		background: transparent;
		border: none;
		color: var(--white);
		display: flex;
		align-items: center;
		justify-content: center;
		width: 2.5rem;
		height: 2.5rem;
		padding: 0;
		cursor: pointer;
		position: relative;
		z-index: 5;
	}

	.nav-toggle__bars {
		position: relative;
		width: 22px;
		height: 16px;
		display: block;
	}

	.nav-toggle__bars span {
		position: absolute;
		left: 0;
		width: 100%;
		height: 2px;
		border-radius: 2px;
		background: currentColor;
		transition: transform 0.25s ease, opacity 0.2s ease, top 0.25s ease;
	}

	.nav-toggle__bars span:nth-child(1) {
		top: 0;
	}

	.nav-toggle__bars span:nth-child(2) {
		top: 7px;
	}

	.nav-toggle__bars span:nth-child(3) {
		top: 14px;
	}

	.nav-toggle[aria-expanded='true'] .nav-toggle__bars span:nth-child(1) {
		top: 7px;
		transform: rotate(45deg);
	}

	.nav-toggle[aria-expanded='true'] .nav-toggle__bars span:nth-child(2) {
		opacity: 0;
	}

	.nav-toggle[aria-expanded='true'] .nav-toggle__bars span:nth-child(3) {
		top: 7px;
		transform: rotate(-45deg);
	}

	.nav-backdrop {
		position: fixed;
		inset: 0;
		background: rgba(44, 31, 23, 0.45);
		opacity: 0;
		pointer-events: none;
		transition: opacity 0.25s ease;
		z-index: 115;
	}

	.nav-backdrop.is-open {
		opacity: 1;
		pointer-events: auto;
	}

	.primary-nav {
		position: fixed;
		inset: 0 0 0 auto;
		width: min(340px, 88vw);
		background: var(--plum);
		padding: 1.25rem 1.5rem 1.5rem;
		transform: translateX(100%);
		transition: transform 0.3s ease;
		overflow-y: auto;
		z-index: 118;
		display: flex;
		flex-direction: column;
		box-shadow: -12px 0 32px rgba(44, 31, 23, 0.25);
	}

	.primary-nav.is-open {
		transform: translateX(0);
	}

	.primary-nav__header {
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding-bottom: 1rem;
		margin-bottom: 0.5rem;
		border-bottom: 1px solid rgba(255, 255, 255, 0.15);
	}

	.primary-nav__header-label {
		color: rgba(255, 255, 255, 0.6);
		font-size: 0.8rem;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		font-weight: 600;
	}

	.nav-close {
		background: rgba(255, 255, 255, 0.1);
		border: none;
		color: var(--white);
		width: 2.25rem;
		height: 2.25rem;
		border-radius: 50%;
		display: flex;
		align-items: center;
		justify-content: center;
		cursor: pointer;
		transition: background 0.2s ease;
	}

	.nav-close:hover {
		background: rgba(255, 255, 255, 0.2);
	}

	.primary-nav__list {
		list-style: none;
		display: flex;
		flex-direction: column;
		gap: 0.1rem;
	}

	.primary-nav__link {
		display: flex;
		align-items: center;
		padding: 0.95rem 0.75rem;
		margin-inline: -0.75rem;
		color: var(--white);
		text-decoration: none;
		font-weight: 500;
		font-size: 1.05rem;
		background: none;
		border: none;
		border-left: 3px solid transparent;
		border-bottom: 1px solid rgba(255, 255, 255, 0.08);
		text-align: left;
		width: calc(100% + 1.5rem);
		cursor: pointer;
		transition: color 0.2s ease, padding-left 0.2s ease, border-color 0.2s ease;
	}

	.primary-nav__link:hover {
		padding-left: 1rem;
	}

	.primary-nav__link:hover,
	.primary-nav__link.active {
		color: var(--gold);
	}

	.primary-nav__link.active {
		border-left-color: var(--gold);
	}

	.has-dropdown .dropdown-trigger {
		justify-content: space-between;
	}

	.dropdown-chevron {
		display: inline-block;
		margin-left: 0.5em;
		transition: transform 0.2s ease;
		color: rgba(255, 255, 255, 0.5);
	}

	.dropdown-trigger[aria-expanded='true'] .dropdown-chevron {
		transform: rotate(180deg);
		color: var(--gold);
	}

	.dropdown-menu {
		list-style: none;
		max-height: 0;
		overflow: hidden;
		opacity: 0;
		padding-left: 1rem;
		border-left: 2px solid rgba(255, 255, 255, 0.2);
		margin-left: 0.25rem;
		transition: max-height 0.3s ease, opacity 0.2s ease;
	}

	.dropdown-menu.is-open {
		max-height: 20rem;
		opacity: 1;
		margin-bottom: 0.35rem;
	}

	.dropdown-menu a {
		display: block;
		padding: 0.6rem 0.25rem;
		color: rgba(255, 255, 255, 0.8);
		text-decoration: none;
		font-size: 0.95rem;
	}

	.dropdown-menu a:hover {
		color: var(--gold);
	}

	.primary-nav__footer {
		margin-top: auto;
		padding-top: 1.25rem;
		display: flex;
		flex-direction: column;
		gap: 0.75rem;
	}

	.nav-call {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 0.5rem;
		color: var(--white);
		text-decoration: none;
		font-weight: 600;
		font-size: 0.95rem;
		padding: 0.85rem 1rem;
		border: 1px solid rgba(255, 255, 255, 0.3);
		border-radius: 999px;
		transition: background 0.2s ease, border-color 0.2s ease;
	}

	.nav-call:hover {
		background: rgba(255, 255, 255, 0.1);
		border-color: rgba(255, 255, 255, 0.5);
	}

	.nav-cta {
		width: 100%;
		text-align: center;
	}

	@media (min-width: 960px) {
		.nav-toggle {
			display: none;
		}

		.primary-nav {
			position: static;
			width: auto;
			background: none;
			padding: 0;
			transform: none;
			overflow: visible;
			/* Unwrap so the link list and CTA place independently on the
			   header grid (list centered, CTA pinned right). Modern
			   browsers keep the <nav> landmark in the a11y tree even
			   though it no longer generates its own box. */
			display: contents;
		}

		.primary-nav__list {
			flex-direction: row;
			align-items: center;
			gap: 0.25rem;
			grid-column: 2;
			justify-self: center;
		}

		.nav-cta {
			grid-column: 3;
			justify-self: end;
		}

		.has-dropdown {
			position: relative;
		}

		.primary-nav__header,
		.nav-close,
		.primary-nav__footer .nav-call {
			display: none;
		}

		.primary-nav__footer {
			display: contents;
		}

		.dropdown-menu {
			position: absolute;
			top: 100%;
			left: 0;
			background: var(--white);
			border-radius: var(--radius-md);
			box-shadow: var(--shadow-soft);
			padding: 0.5rem;
			min-width: 220px;
			border-left: none;
			margin-top: 0.5rem;
			max-height: 0;
			overflow: hidden;
			opacity: 0;
			transition: opacity 0.15s ease;
			pointer-events: none;
		}

		.dropdown-menu.is-open {
			max-height: none;
			opacity: 1;
			pointer-events: auto;
		}

		.dropdown-menu a {
			color: var(--text-dark);
			border-radius: 8px;
			padding: 0.6rem 0.75rem;
		}

		.dropdown-menu a:hover {
			background: var(--cream);
			color: var(--text-dark);
		}

		.primary-nav__link {
			border-left: none;
			border-bottom: none;
			margin-inline: 0;
			width: auto;
			padding: 0.6rem 0.9rem;
		}

		.primary-nav__link:hover {
			padding-left: 0.9rem;
		}

		.primary-nav__link.active {
			border-left: none;
		}

		.nav-cta {
			margin-top: 0;
			width: auto;
		}
	}

	/* Overlay variant: floats transparently over a hero image, pill-shaped nav */
	.site-header--overlay {
		position: relative;
		top: auto;
		z-index: 10;
		background: transparent;
		box-shadow: none;
		padding-block: 1.5rem;
	}

	.site-header--overlay .site-header__logo img {
		filter: drop-shadow(0 1px 14px rgba(44, 31, 23, 0.35));
	}

	.site-header--overlay .nav-toggle {
		text-shadow: 0 1px 14px rgba(44, 31, 23, 0.35);
	}

	.site-header--overlay .container {
		max-width: none;
	}

	@media (min-width: 960px) {
		.site-header--overlay .container {
			padding-inline: 2.5rem;
		}

		.site-header--overlay .primary-nav__list {
			background: rgba(255, 255, 255, 0.16);
			backdrop-filter: blur(10px);
			-webkit-backdrop-filter: blur(10px);
			border: 1px solid rgba(255, 255, 255, 0.4);
			border-radius: 999px;
			padding: 0.5rem 0.6rem;
			gap: 0.15rem;
		}

		.site-header--overlay .primary-nav__link {
			padding: 0.85rem 1.6rem;
			font-size: 1.02rem;
			border-radius: 999px;
			white-space: nowrap;
		}

		.site-header--overlay .primary-nav__link:hover,
		.site-header--overlay .primary-nav__link.active {
			background: rgba(255, 255, 255, 0.22);
			color: var(--white);
		}

		.site-header--overlay .nav-cta {
			padding-inline: 2.1rem;
		}

		.site-header--overlay .dropdown-menu {
			margin-top: 0.75rem;
		}
	}

	:global(body.nav-locked) {
		overflow: hidden;
	}
</style>

<script>
	const toggle = document.getElementById('nav-toggle');
	const close = document.getElementById('nav-close');
	const nav = document.getElementById('primary-nav');
	const backdrop = document.getElementById('nav-backdrop');
	const header = toggle?.closest('.site-header') as HTMLElement | null;

	const openNav = () => {
		nav?.classList.add('is-open');
		backdrop?.classList.add('is-open');
		toggle?.setAttribute('aria-expanded', 'true');
		document.body.classList.add('nav-locked');
		// Some page templates (e.g. the transparent hero overlay header) give
		// .site-header a low page-specific z-index that outranks anything set
		// here by CSS specificity. An inline style always wins, so the open
		// menu reliably sits above other fixed/sticky chrome like the utility bar.
		if (header) header.style.zIndex = '200';
	};

	const closeNav = () => {
		nav?.classList.remove('is-open');
		backdrop?.classList.remove('is-open');
		toggle?.setAttribute('aria-expanded', 'false');
		document.body.classList.remove('nav-locked');
		if (header) header.style.zIndex = '';
		toggle?.focus();
	};

	toggle?.addEventListener('click', () => {
		if (nav?.classList.contains('is-open')) {
			closeNav();
		} else {
			openNav();
		}
	});

	close?.addEventListener('click', closeNav);
	backdrop?.addEventListener('click', closeNav);

	document.addEventListener('keydown', (event) => {
		if (event.key === 'Escape' && nav?.classList.contains('is-open')) {
			closeNav();
		}
	});

	const dropdownTrigger = document.querySelector('.dropdown-trigger');
	const dropdownMenu = document.getElementById('services-menu');

	dropdownTrigger?.addEventListener('click', () => {
		const isOpen = dropdownMenu?.classList.toggle('is-open');
		dropdownTrigger.setAttribute('aria-expanded', String(Boolean(isOpen)));
	});

	document.addEventListener('click', (event) => {
		const target = event.target as Node;
		if (!dropdownTrigger?.contains(target) && !dropdownMenu?.contains(target)) {
			dropdownMenu?.classList.remove('is-open');
			dropdownTrigger?.setAttribute('aria-expanded', 'false');
		}
	});
</script>
